# Copy to .env and fill in values. Never commit .env to git.

# ── Frontend (set in Streamlit Cloud secrets, or your shell) ───────────────
BACKEND_URL=http://localhost:8000

# ── Footer links (frontend; leave LinkedIn empty to hide it) ───────────────
GITHUB_URL=https://github.com/sami7507
LINKEDIN_URL=https://www.linkedin.com/in/sami7507

# ── Backend ────────────────────────────────────────────────────────────────
DEBUG=false
# REQUIRED in production: long random string used to sign login sessions
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
AUTH_REQUIRED=true
ALLOW_GUEST=true
CORS_ORIGINS=*                       # production: your Streamlit URL
RATE_LIMIT_PER_MINUTE=60
API_KEY=                             # server-to-server key (X-API-Key); also lets YOU read feedback
FRONTEND_URL=http://localhost:8501   # where users return after Google sign-in
BACKEND_PUBLIC_URL=http://localhost:8000

# ── Google sign-in (optional) ──────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorised redirect URI:  <BACKEND_PUBLIC_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Mobile sign-in (SMS one-time code) ─────────────────────────────────────
SMS_PROVIDER=console                 # console = print code in API logs | twilio
OTP_DEV_ECHO=false                   # true = show the code on screen (LOCAL DEMOS ONLY)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                         # your Twilio number, e.g. +15551234567

# ── Database ───────────────────────────────────────────────────────────────
# Default = SQLite file (zero setup, but resets on hosts with ephemeral disks like Render's free tier).
# For persistence set a PostgreSQL URL (Render Postgres, Neon, Supabase, RDS …) — tables are created automatically:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# TRIAVIA_DB_PATH=database/data/triavia.db   # SQLite location (only used when DATABASE_URL is empty)
